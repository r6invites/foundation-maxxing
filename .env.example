# Frontend build-time variables (the ONLY values allowed in frontend code).
# Copy to .env.local for local development. Never put a service-role key here.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-anon-key

# Where the site is served from. Leave unset for relative assets (works anywhere).
#   GitHub Pages sub-path: /foundation-maxxing/
#   Custom root domain:    /
# VITE_BASE_PATH=/foundation-maxxing/
